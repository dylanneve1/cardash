<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+): a full-bleed dark background so the launcher's
     mask fills, with the gauge as the foreground. API 21-25 keep the PNGs
     in mipmap-*dpi. The foreground doubles as the Android 13 themed icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
